# 环境变量模板。复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交。
# 用法: cp .env.example .env

# 模型类型: openai | ark
MODEL_TYPE=openai

# OpenAI（MODEL_TYPE=openai 时使用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BY_AZURE=false

# 火山引擎 Ark（MODEL_TYPE=ark 时使用）
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# CozeLoop 链路追踪（可选）
# COZELOOP_WORKSPACE_ID=
# COZELOOP_API_TOKEN=
